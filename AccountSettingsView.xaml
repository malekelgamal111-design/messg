            <!-- ══════════════════════════
     TAB 3 — PLAYER MAP
══════════════════════════ -->
            <TabItem Header="Player Map" x:Name="TabPlayerMap">
                <Border Background="#0F172A" BorderBrush="#1E293B"
            BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Info Bar -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B"
                    BorderThickness="0,0,0,1" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10B981"
                                 VerticalAlignment="Center"/>
                                    <TextBlock Text="MINIMAP" Foreground="#10B981" FontSize="10"
                                   FontWeight="Bold" Margin="6,0,0,0"
                                   VerticalAlignment="Center"/>
                                    <TextBlock Text=" — Click on map to teleport (auto-pathfinding)"
                                   Foreground="#4B5563" FontSize="10"
                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#0F3460"
                            CornerRadius="6" Padding="12,4">
                                    <Label x:Name="CoordLabel"
                               Content="X: ---   Y: ---"
                               Foreground="#06B6D4"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Padding="0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Map Container with Viewbox for scaling -->
                        <Border Grid.Row="1"
    Background="#0A0E27"
    ClipToBounds="True"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Padding="16">

                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="MapImage"
                   Width="800"
                   Height="800"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Stretch="Fill"/>
                            </Viewbox>

                        </Border>

                    </Grid>
                </Border>
            </TabItem>
